config CLOCK_CONTROL_MT8188_INFRA_AO
	bool "MediaTek MT8188 infra always-on clock controller"
	default y
	depends on DT_HAS_MEDIATEK_MT8188_INFRACFG_AO_ENABLED
	help
	  Enable the peripheral gate clocks in the MT8188 infra always-on
	  subsystem.

config CLOCK_CONTROL_MT8188_APMIXED
	bool "MediaTek MT8188 APMIXEDSYS PLL clock controller"
	default y
	depends on DT_HAS_MEDIATEK_MT8188_APMIXEDSYS_ENABLED
	help
	  Enable the phase-locked loops in the MT8188 APMIXEDSYS block,
	  including the APLL1 and APLL2 audio pair.

config CLOCK_CONTROL_MT8188_TOPCKGEN
	bool "MediaTek MT8188 TOPCKGEN clock controller"
	default y
	depends on DT_HAS_MEDIATEK_MT8188_TOPCKGEN_ENABLED
	help
	  Enable the top-level muxes, dividers and gates that distribute the
	  MT8188 PLL outputs, including the audio timing domains and the
	  per-port audio master clocks.
