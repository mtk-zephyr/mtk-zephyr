if SOC_MT8188_A55

# The Cortex-A cores can run alongside another operating system, so the GIC
# distributor must not be reprogrammed from scratch during initialisation.
config GIC_SAFE_CONFIG
	default y

# Covers the full GICv3 SPI range; the highest INTID this die can raise is
# below 1024 and the software ISR table is sized from this value.
config NUM_IRQS
	default 1024

# The audio front end reaches its clock controllers during its own
# initialisation, so they have to be brought up ahead of ordinary devices.
config CLOCK_CONTROL_INIT_PRIORITY
	default 1

endif # SOC_MT8188_A55
